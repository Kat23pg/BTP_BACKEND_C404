@EndUserText.label: 'Travel - Service Definition'
define service ZSD_TRAVEL_2803 {
  expose ZTRAVEL_C_2803           as Travel;
  expose ZBOOKING_C_2803          as Booking;
  expose ZBKSPPL_C_2803           as BookingSupplement;
  expose /DMO/I_Customer          as Passenger;
  expose /DMO/I_Agency            as Agency;
  expose /DMO/I_Carrier           as Carrier;
  expose /DMO/I_Connection        as Connection;
  expose /DMO/I_Flight            as Flight;
  expose /DMO/I_Airport           as Airport;
  expose /DMO/I_Overall_Status_VH as OverallStatusVH;
  expose I_Currency               as Currency;
  expose I_Country                as Country;
}